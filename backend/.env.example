# Salin ke backend/.env lalu isi nilainya.

# ENV: development | staging | production
# (production = cookie Secure + SameSite=None; butuh HTTPS)
ENV=development

# Server
PORT=8080
# URL publik backend; dipakai untuk membangun URL file upload (cover/audio).
PUBLIC_BASE_URL=http://localhost:8080
# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
FRONTEND_ORIGIN=http://localhost:3000

# Database (PostgreSQL 14+)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=melodify

# JWT
# Wajib. Gunakan string acak panjang, mis.: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_key_yang_panjang_dan_acak
# Opsional (default: 15m dan 720h = 30 hari)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Opsional: domain cookie refresh token (kosongkan di localhost)
# COOKIE_DOMAIN=
